 supabase/functions/sync-steps/index.ts        |  62 ++++---
 supabase/migrations/015_wallet_security.sql   | 164 ++++++++++++++++++
 5 files changed, 354 insertions(+), 84 deletions(-)
 create mode 100644 supabase/migrations/015_wallet_security.sql

